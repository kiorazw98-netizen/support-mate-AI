# Optional: without a key, answers come directly from the knowledge base.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: defaults to support_mate.db beside main.py.
# DATABASE_PATH=./support_mate.db

# Required to access the admin dashboard and knowledge-base editor.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set SESSION_COOKIE_SECURE=true when serving over HTTPS.
# APP_ENV=production also enables secure cookies.
# SESSION_COOKIE_SECURE=false
